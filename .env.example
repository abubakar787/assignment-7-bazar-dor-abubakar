# MongoDB connection string (used by Better Auth to store users/sessions)
DATABASE_URL=

# Long random secret for signing sessions. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# Public base URL of the app. Must match where the app is served, e.g.
#   http://localhost:3000        (local)
#   https://your-app.vercel.app  (production)
BETTER_AUTH_URL=

# Google OAuth credentials (Google Cloud Console)
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_SECRET=

# GitHub OAuth credentials (GitHub Developer Settings)
BETTER_AUTH_GITHUB_CLIENT_ID=
BETTER_AUTH_GITHUB_SECRET=
